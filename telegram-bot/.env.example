# Скопируйте этот файл в .env и заполните. Файл .env никому не пересылайте.
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram chat_id — сюда приходят заявки
ADMIN_CHAT_ID=
# Случайная строка 32+ символов (латиница, цифры, _ и -) — защищает вебхук
WEBHOOK_SECRET=
# Адрес бота на хостинге
PUBLIC_URL=https://bot.realtyminaev.ru
# Путь вебхука на сервере
WEBHOOK_PATH=/webhook
# Адрес Mini App «Визитка»
WEBAPP_URL=https://realtyminaev.ru/card/app/
