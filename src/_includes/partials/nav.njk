{#- Меню сайта. Один источник — site.menu в src/_data/site.js.
    prefix делает id выпадающих списков уникальными, когда на странице
    два меню (на главной: поверх фото и в липкой шапке). -#}
{%- from "partials/icons.njk" import icon -%}

{%- macro desktop(menu, url, prefix="dd", cls="") -%}
<ul class="nav{% if cls %} {{ cls }}{% endif %}">
{%- for m in menu %}
  <li>
  {%- if m.items %}
    <button class="nav-a" aria-expanded="false" aria-controls="{{ prefix }}-{{ loop.index }}">{{ m.title }} {{ icon("down") | safe }}</button>
    <div class="dd" id="{{ prefix }}-{{ loop.index }}">
      {%- for i in m.items %}<a href="{{ i.url }}"{% if i.muted %} class="more"{% endif %}{% if i.url == url %} aria-current="page"{% endif %}>{{ i.title }}</a>{% endfor %}
    </div>
  {%- else %}
    <a class="nav-a" href="{{ m.url }}"{% if url and url.startsWith(m.url) %} aria-current="page"{% endif %}>{{ m.title }}</a>
  {%- endif %}
  </li>
{%- endfor %}
</ul>
{%- endmacro -%}

{%- macro mobile(menu, url) -%}
{%- for m in menu %}
  {%- if m.items %}
  <details{% if m.items | hasUrl(url) %} open{% endif %}>
    <summary>{{ m.title }}</summary>
    <ul>{% for i in m.items %}<li><a href="{{ i.url }}">{{ i.title }}</a></li>{% endfor %}</ul>
  </details>
  {%- else %}
  <a class="ml" href="{{ m.url }}">{{ m.title }}</a>
  {%- endif %}
{%- endfor %}
{%- endmacro -%}
