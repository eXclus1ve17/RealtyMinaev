---
layout: layouts/base.njk
---
{#- Страница услуги. Всё содержимое — в front matter страницы. -#}
{%- from "partials/icons.njk" import icon, pain -%}
{%- from "partials/cta.njk" import cta with context -%}
{%- from "partials/blocks.njk" import brief, cardsBlock, faqBlock -%}

<section class="ph"><div class="wrap ph-grid">
  <div class="ph-main">
    <span class="eyebrow">{{ eyebrow }}</span>
    <h1 class="h1">{{ h1 | safe }}</h1>
    <p class="lead">{{ lead | safe }}</p>
    {%- if free %}<p class="free">{{ free | safe }}</p>{% endif %}
  </div>
  {{ brief(briefItems) }}
</div></section>

{%- if pairs %}
<section class="section"><div class="wrap">
  <div class="head"><span class="eyebrow">С чем приходят</span><h2 class="h2">{{ pairsTitle }}</h2></div>
  <div class="pairs">
    {%- for p in pairs %}<div class="pair">{% if p.ic %}<span class="pain-ic">{{ pain(p.ic) | safe }}</span>{% endif %}<div class="pair-b"><p class="q">{{ p.q }}</p><p class="a">{{ p.a | safe }}</p></div></div>{% endfor %}
  </div>
</div></section>
{%- endif %}

<section class="section"><div class="wrap">
  <div class="head"><span class="eyebrow">Как я работаю</span><h2 class="h2">{{ stepsTitle }}</h2></div>
  <div class="algo">
    <div>
      <div class="algo-h"><span class="t">Что я делаю</span>{% if term %}<span class="term"><i>{{ term.label }}</i>{{ term.value }}</span>{% endif %}</div>
      <ol class="algo-steps">
        {%- for s in steps %}<li class="algo-step"><div><b>{{ s.t }}</b><p>{{ s.p | safe }}</p></div></li>{% endfor %}
      </ol>
    </div>
    <div class="algo-out">
      <p class="t">Что получаете вы</p>
      <ul>{% for o in out %}<li><span class="tick">{{ icon("tick") | safe }}</span>{{ o | safe }}</li>{% endfor %}</ul>
    </div>
  </div>
</div></section>

{%- if deals %}
<section class="section"><div class="wrap">
  <div class="cases">
    <div class="head"><span class="eyebrow">Если есть сложность</span><h2 class="h2">{{ dealsTitle or "Отдельно разбираю каждый случай" }}</h2>{% if dealsLead %}
      <p class="lead">{{ dealsLead | safe }}</p>{% endif %}</div>
    <div class="cases-grid">
      {%- for d in deals %}<a class="case" href="{{ d.url }}"><h3>{{ d.t }}</h3><p>{{ d.p }}</p><span class="go">Подробнее →</span></a>{% endfor %}
    </div>
  </div>
</div></section>
{%- endif %}

{{ content | safe }}

{%- if cases %}
<section class="section"><div class="wrap">
  <div class="head"><span class="eyebrow">Из практики</span><h2 class="h2">Как это было у других</h2></div>
  <div class="cards" style="--cols:{{ cases.length if cases.length < 3 else 3 }}">{% for c in cases %}<div class="card"><span class="k">Кейс</span><h3>{{ c.t }}</h3><p>{{ c.p }}</p></div>{% endfor %}</div>
</div></section>
{%- endif %}

{%- if faq %}
{{ faqBlock(faq, faqTitle or "Что спрашивают чаще всего") }}
{%- elif site.draft %}
<section class="section"><div class="wrap">
  <p class="draft"><span class="fill">[ЧЕРНОВИК: вопросы по этой услуге подготовлю после вашего одобрения.]</span></p>
</div></section>
{%- endif %}

{%- if articles %}
{{ cardsBlock("Почитать", "По теме", articles) }}
{%- endif %}

{{ cta(ctaTitle, ctaText) }}
