# realtyminaev.ru — настройки сервера (Apache на reg.ru).
# Выкладывается в корень сайта как .htaccess. Перед выкладкой — копия текущего файла.

AddDefaultCharset UTF-8
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# один адрес сайта: https и без www — одним редиректом
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://realtyminaev.ru%{REQUEST_URI} [R=301,L]

# /index.html → /  (и для вложенных разделов)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
</IfModule>

# настройки заявки и журнал заявок не отдаются наружу
<FilesMatch "^(lead-config\.php|leads\.csv)$">
  Require all denied
</FilesMatch>

# сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml image/svg+xml
</IfModule>

# кэш: страницы — проверять каждый раз, файлы с ?v=… — надолго
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
AddType image/avif .avif
AddType font/woff2 .woff2
